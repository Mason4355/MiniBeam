{
  "name": "minibeam",
  "version": "0.2.0",
  "description": "Portable shared Chromium room with chat, room invites, and built-in ad blocking.",
  "author": "Mason4355",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "npm run client",
    "server": "electron . --host",
    "client": "electron .",
    "check": "node --check src/main/main.js && node --check src/preload/preload.js && node --check src/server/room-server.js && node --check src/server/standalone.js && node --check src/host/host-main.js && node --check src/renderer/app.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.minibeam.browser",
    "productName": "MiniBeam",
    "asar": true,
    "directories": {
      "output": "fresh-release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "MiniBeam.exe"
    }
  }
}
