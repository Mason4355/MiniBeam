{
  "name": "minibeam",
  "version": "0.2.0",
  "description": "Portable shared Chromium room with chat, room invites, and built-in ad blocking.",
  "author": "Mason4355",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node launcher.js",
    "server": "node server.js",
    "client": "electron .",
    "check": "node --check server.js && node --check launcher.js && node --check main.js && node --check preload.js && node --check renderer.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.minibeam.browser",
    "productName": "MiniBeam",
    "asar": true,
    "directories": {
      "output": "fresh-release"
    },
    "files": [
      "server.js",
      "launcher.js",
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "docs/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "MiniBeam.exe"
    }
  }
}
