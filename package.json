{
  "name": "minibeam",
  "version": "0.1.0",
  "description": "Portable Electron prototype for synchronized video watching over a public IP.",
  "author": "Mason4355",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win portable",
    "check": "node --check src/main/main.js && node --check src/server/server.js && node --check src/renderer/app.js && node --check src/preload/preload.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.minibeam.prototype",
    "productName": "MiniBeam",
    "asar": true,
    "directories": {
      "output": "portable"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "MiniBeam.exe"
    }
  }
}
